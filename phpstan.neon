parameters:
    paths:
        - src
    excludes_analyse:
        - src/Controller/Action/Api/*
    ignoreErrors:
        - '#Call to an undefined method Sylius\\Component\\Core\\Model\\PaymentMethod::setTestWebhookConfigurationDate\(\).#'
        - '#Call to an undefined method Sylius\\Component\\Core\\Model\\PaymentMethod::setProductionWebhookConfigurationDate\(\).#'
        - '#Call to an undefined method Sylius\\Component\\Core\\Model\\PaymentMethod::getTestWebhookConfigurationDate\(\).#'
        - '#Call to an undefined method Sylius\\Component\\Core\\Model\\PaymentMethod::getProductionWebhookConfigurationDate\(\).#'
        - '#Call to an undefined method Sylius\\Component\\Core\\Model\\PaymentInterface::setPaymentApiId\(\).#'
        - '#Call to an undefined method Sylius\\Component\\Payment\\Model\\PaymentMethodInterface::isPaymentAccount\(\).#'
        - '#Call to an undefined method Sylius\\Component\\Core\\Model\\PaymentInterface::getBankId\(\).#'
        - '#Call to an undefined method Sylius\\Component\\Core\\Model\\PaymentInterface::getPaymentApiId\(\).#'
        - '#Call to an undefined method Sylius\\Component\\Core\\Model\\PaymentInterface::setBankId\(\).#'
        - identifier: missingType.generics
          paths:
              - src/Service/BridgeWebhookService.php
              - src/Repository/PaymentMethodRepository.php
              - src/Controller/Action/FailedStatusAction.php
              - src/Repository/PaymentMethodRepositoryInterface.php
              - src/Controller/Action/UpdateSelectedBankOnPaymentAction.php
        - identifier: class.notFound
          path: src/EventListener/PaymentMethodListener.php
        - identifier: missingType.iterableValue
          paths:
              - src/Client/BridgePaymentApiClient.php
              - src/Form/Extension/PaymentMethodTypeExtension.php
              - src/DependencyInjection/BridgeSyliusPaymentExtension.php
        - identifier: argument.type
          paths:
              - src/BridgePaymentGatewayFactory.php
              - src/EventListener/PaymentMethodListener.php
        - identifier: return.type
          path: src/Client/BridgePaymentApiClient.php
    level: max
